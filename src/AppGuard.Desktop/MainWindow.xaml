<Window x:Class="AppGuard.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AppGuard" Width="1180" Height="760" MinWidth="920" MinHeight="620" Background="#11151B" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closing="Window_Closing">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="#171C23" BorderBrush="#252C36" BorderThickness="0,0,1,0">
   <DockPanel Margin="18,22">
    <StackPanel DockPanel.Dock="Top">
     <StackPanel Orientation="Horizontal" Margin="3,0,0,32"><Border Width="34" Height="34" CornerRadius="10" Background="#233E36"><TextBlock Text="A" Foreground="{StaticResource Accent}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="11,0"><TextBlock Text="AppGuard" FontSize="17" FontWeight="Bold"/><TextBlock Text="WINDOWS PROCESS GUARD" Foreground="{StaticResource Muted}" FontSize="9" Margin="0,2,0,0"/></StackPanel></StackPanel>
     <TextBlock Text="WORKSPACE" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold" Margin="8,0,0,9"/>
     <Button x:Name="DashboardNav" Content="◫   Dashboard" HorizontalContentAlignment="Left" Margin="0,0,0,5" Click="Dashboard_Click"/>
     <Button x:Name="ApplicationsNav" Content="▣   Applications" HorizontalContentAlignment="Left" Margin="0,0,0,5" Click="Applications_Click"/>
     <Button x:Name="ActivityNav" Content="◷   Activity Monitor" HorizontalContentAlignment="Left" Margin="0,0,0,5" Click="Activity_Click"/>
     <Button x:Name="LogsNav" Content="☷   Logs" HorizontalContentAlignment="Left" Margin="0,0,0,5" Click="Logs_Click"/>
     <Button x:Name="SettingsNav" Content="⚙   Settings" HorizontalContentAlignment="Left" Margin="0,0,0,5" Click="Settings_Click"/>
    </StackPanel>
    <Border DockPanel.Dock="Bottom" Background="#20262F" CornerRadius="12" Padding="13" Margin="0,16,0,0"><StackPanel><TextBlock Text="SAFETY MODE" Foreground="{StaticResource Muted}" FontWeight="Bold" FontSize="10"/><TextBlock Text="Dry Run is enabled" Foreground="{StaticResource Accent}" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="No process can be terminated in this mode." Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"/></StackPanel></Border>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="34,28,34,28">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel Grid.Row="0" Margin="0,0,0,26"><StackPanel><TextBlock x:Name="PageTitle" Text="Dashboard" FontSize="27" FontWeight="Bold"/><TextBlock x:Name="PageSubtitle" Text="A clear view of your approved applications." Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel><Border DockPanel.Dock="Right" Background="#20262F" CornerRadius="18" Padding="12,7" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#E6B85C" Margin="0,0,8,0"/><TextBlock Text="Monitoring stopped" FontSize="12"/></StackPanel></Border></DockPanel>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="PageContent"/></ScrollViewer>
  </Grid>
 </Grid>
</Window>
